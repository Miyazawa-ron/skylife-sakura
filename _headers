/*.html
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800, s-maxage=2592000

/*
  Cache-Control: public, max-age=86400, s-maxage=604800

/store/*
  Cache-Control: public, max-age=0, s-maxage=0
